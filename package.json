{
  "name": "unzip",
  "version": "1.0.0",
  "description": "Faster unzip library for Node.js",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "default": "./dist/index.mjs",
        "types": "./dist/index.d.mts"
      },
      "require": {
        "default": "./dist/index.cjs",
        "types": "./dist/index.d.cts"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "bench": "vitest bench",
    "bench:manual": "tsc benchmark.ts --module nodenext --moduleResolution nodenext --outDir ./dist && node ./dist/benchmark.js",
    "build": "tsdown",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "Thomas F. K. Jorna",
  "license": "MIT",
  "packageManager": "pnpm@10.4.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.2",
    "@biomejs/biome": "^2.3.8",
    "@types/adm-zip": "^0.5.5",
    "@types/node": "24",
    "@types/unzipper": "^0.10.10",
    "@types/yauzl": "^2.10.3",
    "adm-zip": "^0.5.16",
    "extract-zip": "^2.0.1",
    "tsdown": "0.17.0-beta.3",
    "typescript": "^5.9.3",
    "unzipper": "^0.12.3",
    "vitest": "^4.0.14",
    "yauzl": "^3.2.0"
  }
}
